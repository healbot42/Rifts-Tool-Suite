{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rifts-data-api",
  "main": "worker.js",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rifts-tool-suite",
      "database_id": "REPLACE_WITH_CLOUDFLARE_DATABASE_ID",
    },
  ],
}
