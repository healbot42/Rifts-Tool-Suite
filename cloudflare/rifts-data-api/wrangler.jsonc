{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rifts-data-api",
  "main": "worker.js",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "triggers": {
    "crons": ["23 3 * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rifts-tool-suite",
      "database_id": "f795a721-bb11-44e9-b72a-8161e8b4cae4",
    },
  ],
}
